# aina configuration template
# Copy to .env if you wish to override default host or model settings.
# Default uses local Ollama without requiring any API keys.

# Ollama local settings (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=qwen2.5:7b

# Optional: Cloud API keys (if using remote OpenAI/Anthropic proxies)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
